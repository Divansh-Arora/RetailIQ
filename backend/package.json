{
  "name": "retailiq-backend",
  "version": "1.0.0",
  "description": "RetailIQ REST API (Express + MySQL)",
  "type": "module",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
    "db:init:schema-only": "node scripts/init-db.js --no-seed",
    "test": "node ../tests/run-all.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mysql2": "^3.11.5"
  }
}
